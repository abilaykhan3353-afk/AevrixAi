{
  "name": "aevrix-ai",
  "version": "3.0.0",
  "description": "ИИ-помощник с диалогами, памятью, учебными режимами и документами",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "node scripts/build-assets.js",
    "test": "node --experimental-vm-modules --test --test-concurrency=1 tests/v3/integration.test.js tests/v3/lifecycle.test.js tests/v3/client.test.js tests/v3/tools.test.js",
    "test:browser": "node scripts/browser-check.js",
    "preview": "node scripts/preview.js",
    "eval": "node scripts/eval.js",
    "check:models": "node scripts/check-models.js",
    "migrate": "node scripts/migrate.js",
    "test:smoke": "node scripts/smoke.js"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "dompurify": "3.4.16",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "gpt-tokenizer": "4.0.0",
    "helmet": "8.3.0",
    "highlight.js": "11.12.0",
    "jsonwebtoken": "9.0.3",
    "marked": "18.1.0",
    "pdf-parse": "2.4.5",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "playwright": "1.64.0",
    "supertest": "7.3.1"
  }
}
