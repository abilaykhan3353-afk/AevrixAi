PORT=3000
NODE_ENV=development
GROQ_API_KEY=
DATABASE_URL=
# Required for accounts: random secret of at least 32 bytes.
JWT_SECRET=
ADMIN_PASSWORD=
# Production: HTTPS origin, no trailing slash.
PUBLIC_ORIGIN=
ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=0

# SSL certificates are always verified. For local PostgreSQL ONLY use disable.
PG_SSL_MODE=require
PG_CA_FILE=
# Only set true after backing up and verifying your OLD database.
LEGACY_BACKUP_CONFIRMED=false

REQUEST_DEADLINE_MS=60000
CONTEXT_TOKEN_BUDGET=14000
MAX_OUTPUT_TOKENS=4096
CHAT_REQUESTS_PER_MINUTE=12
MAX_ACTIVE_GENERATIONS=8
MAX_DAILY_GENERATIONS=500
# 0 = no automated deletion. Positive number enables daily cleanup of inactive conversations/reports.
DATA_RETENTION_DAYS=0

CHAT_MODEL=openai/gpt-oss-20b
# Empty = no second model, preventing unexpected extra provider calls/cost.
CHAT_FALLBACK_MODEL=
VISION_MODEL=qwen/qwen3.8-27b
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
POLLINATIONS_API_KEY=
IMAGE_MODEL=flux
# auto prefers Cloudflare when configured. Free Workers plan: FLUX.1 schnell only.
IMAGE_PROVIDER=auto
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
IMAGE_ENHANCE_PROMPT=true
VISION_PROVIDER=groq
# One-time owner diagnostics, status-only logs. Disable after verification.
CHECK_PROVIDERS_ON_STARTUP=false
NEWSDATA_API_KEY=
GNEWS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
